{
  "name": "aw_zsp45",
  "type": "Gun",
  "maxAmmoCapacity": 18,
  "compatibleAmmo": ["ammocreative" ,"aw_pistols_ammo"],
  "damage": 5,
  "rpm": 260,
  "fireModes": ["SINGLE"],
  "fireSound": "aw_zsp45_fire",
  "aimingZoom": 0.1,
  "ammoUi": "aw_ammo_ui",
  "gunRecoilInitialAmplitude": 0.2,
  "shakeRecoilAmplitude": 1.2,
  "shakeRecoilSpeed": 3,
  "viewRecoilAmplitude": 4.0,
  "firstPersonFallbackAnimations": "pistols_walking_animations",
  "toggle_aiming": true,
  "aimingEnabled" : true,
  "noADSDuringInspect": true,
  "disableAdsDuringreload": false,
  "sustainedRecoil": {
    "posZCap": 0.22,  // weapon moves backward slightly each shot.
    "posZIncrement": 0.05, // after about 3 shots, it reaches the maximum sustained rearward movement.
    "pitchIncrement": -0.04, // additional upward climb over sustained fire.
    "posYIncrement": 0.3 //  vertical displacement buildup.
  },
//Here Idle Animations Goes as planned so I wont break anything


  "idleAnimations": [
    {
      "name": "animation.model.idle",
      "duration": 270,
      "condition": "ammoCount > 0"
    },
    {
      "name": "animation.model.idle_empty",
      "duration": 270,
      "condition": "ammoCount == 0"
    }
  ],


// Now starts Inspect Animations
  "inspectAnimations": [
    {
      "name": "animation.model.inspect",
      "duration": 4310,
      "condition": "ammoCount > 0"
    },
    {
      "name": "animation.model.inspect_empty",
      "duration": 4310,
      "condition": "ammoCount == 0"
    }
  ],


  "fireAnimations" : [
    {
      "name": "animation.model.fire",
      "condition": "ammoCount > 1"

    },
    {
      "name": "animation.model.fire_last",
      "condition": "ammoCount < 1"
    }

  ],


// Draw Animations also supports empty ones
  "drawAnimations": [
    {
      "name": "animation.model.draw",
      "duration": 700,
      "condition": "ammoCount > 0"
    },
    {
      "name": "animation.model.draw_empty",
      "duration": 700,
      "condition": "ammoCount == 0"
    }
  ],


// Now here is the crazy part thing called Features on how do I want my gun to Behave  whern certain attachmentments putted

  "features": [


    // Now we will use muzzle Flash Effect after putting a muzzle attachment
    {
      "type": "MuzzleFlash",
      "effects": [
        {
          "phase": "firing",
          "name": "muzzle_flash"
        }
      ],

      // If the Smg Suprerssors or any kind of suppressors are putted then muzzle flash will now shown
      "condition": {
        "allOf": [
          {
            "isUsingDefaultMuzzle": true
          },
          {
            "doesNotHaveAttachmentGroup": "smg_suppressors"
          }
        ]
      }

    },
    {
      "type": "custom_crosshair",
      "enabled": true,
      "texture": "textures/custom_crosshairs/argos_weaponry_crosshair.png",
      "layout": "pointblank"
    },

    {
      "type": "AdsConstraint",
      "enabled": true,
      "camera": true,
      "cameraConstraint" : 0.6
    },

    {
      "type": "AdsReloadZoomControl",
      "enabled": true,
      // Available Strings for Zoom type
      // linear
      //smooth
      //ease_in
      //ease_out
      //ease_in_out
      //sine_in
      //sine_out
      //sine_in_out
      "zoom_type": "smooth",
      "amount": 0.08
    },

    {
      "type": "Melee",
      "enabled": true,
      "damage": 8.0,
      "cooldown": 20,
      "reach": 3.0,
      "damageCatsandOcalotsEntities" : true,
      "meleeAnimations": [
        {
          "name": "animation.model.melee_1",
          "duration": 700,
          "preMelee": 200
        },
        {
          "name": "animation.model.melee_2",
          "duration": 870,
          "preMelee": 220
        },
        {
          "name": "animation.model.melee_3",
          "duration": 850,
          "preMelee": 220
        }
      ]
    },

    //Now finally teh fire sounds will change after putting a suppressor
    {
      "type": "Sound",
      "fireSounds": [
        {
          "sound": "aw_zsp45_suppressed",
          "volume": 0.5,
          "condition": {
            "allOf": [
              {
                "hasAttachmentGroup": "smg_suppressors"
              }
            ]
          }
        },
        {
          "sound": "aw_zsp45_fire",
          "volume": 1
        }


      ]
    },







    // Now If I Want my default ironsights to be dissappeard when putting a scope "Part Visibility feature needed
    {
      "type": "PartVisibility",
      "parts": [

        // hiding the Extended Magzines
        {
          "name": "mag_extended",
          "visible": true,
          "condition": {
            "hasAttachmentGroup": "extended_mag_1"
          }
        },
        {
          "name": "2nd_mag_extended",
          "visible": true,
          "condition": {
            "hasAttachmentGroup": "extended_mag_1"
          }
        },

        // Hiding the default 2nd magazine

        {
          "name": "mag_default",
          "visible": false,
          "condition": {
            "hasAttachmentGroup": "light_extended_mags"
          }
        },
        {
          "name": "2nd_mag_default",
          "visible": false,
          "condition": {
            "hasAttachmentGroup": "light_extended_mags"
          }
        }



      ]
    }





  ],



  "phasedReloads": [

    // First we will call it the Normal Empty Reload
    {
      "phase": "RELOADING",
      "duration": 2520,
      "animation": "animation.model.reload_empty",
      "condition": {
        "allOf": [
          "reloadIterationIndex == 0",
          {
            "onEmptyReload": true
          },
          {
            "doesNotHaveAttachmentGroup": "extended_mag_1"
          }
        ]
      }
    },

    // Now the the Extended magazine empty Reload

    {
      "phase": "RELOADING",
      "duration": 2520,
      "animation": "animation.model.reload_empty_ext",
      "condition": {
        "allOf": [
          "reloadIterationIndex == 0",
          {
            "onEmptyReload": true
          },
          {
            "hasAttachmentGroup": "extended_mag_1"
          }
        ]
      }
    },

    // Here we will do the Normal Relod when the gun is not empty
    {
      "phase": "RELOADING",
      "duration": 1900,
      "animation": "animation.model.reload",
      "condition": {
        "allOf": [
          "reloadIterationIndex > 0",
          {
            "onEmptyReload": false
          },
          {
            "doesNotHaveAttachmentGroup": "extended_mag_1"
          }
        ]
      }
    },

    {
      "phase": "RELOADING",
      "duration": 1920,
      "animation": "animation.model.reload_ext",
      "condition": {
        "allOf": [
          "reloadIterationIndex > 0",
          {
            "onEmptyReload": false
          },
          {
            "hasAttachmentGroup": "extended_mag_1"
          }
        ]
      }
    }




  ],




  "compatibleAttachmentGroups": [
    "smg_muzzle",
    "light_extended_mags"
  ],




  // Effects For Muzzle Flash
  "effects": [
    {
      "phase": "hit_scan_acquired",
      "name": "tracer"
    },
    {
      "phase": "firing",
      "name": "muzzle_flash_small"
    }
  ]

}
